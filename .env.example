# Copy this file to .env and fill in the values below. .env is gitignored
# and must never be committed.

# Neon connection string in production, a SQLite path locally.
DATABASE_URL=sqlite:///./sabha.db

# From Google AI Studio, no card required. Leave unset until step 9.
GEMINI_API_KEY=

# Model identifiers live in api/sabha/llm/client.py. These defaults match
# that file; override only to test a different model. text-embedding-004
# no longer exists (confirmed 404 in step 9); gemini-embedding-2 is the
# fallback if gemini-embedding-001 is ever unavailable.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_MODEL_FALLBACK=gemini-embedding-2

# Gemini free tier request limits, verified in step 9 against the AI
# Studio rate limit dashboard for this project: 5 RPM, 250,000 TPM, 20
# RPD for gemini-2.5-flash text output. See docs/decisions/0003.
QUOTA_RPM=5
QUOTA_RPD=20

# mock is the only value used anywhere in this build. Never point this at a
# real government portal or ministry address.
FILING_MODE=mock

# 1 in normal operation. Set higher only to compress the statutory clock
# for a demonstration, and the interface must show plainly that it is
# compressed whenever this is not 1.
DEMO_CLOCK_SCALE=1
